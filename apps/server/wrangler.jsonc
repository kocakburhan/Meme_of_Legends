{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mol-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],

  "triggers": { "crons": ["*/10 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mol-db",
      "database_id": "a18b06b0-5204-4ee8-a5e0-82f64027f53f",
    },
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mol-media",
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDurableObject",
      },
    ],
  },

  // SQLite-backed Durable Object (per-room state).
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"],
    },
  ],
}
